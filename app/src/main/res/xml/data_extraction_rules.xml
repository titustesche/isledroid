<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Settings are backed up / transferred; assistant API keys never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
